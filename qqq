[32m+[m
[32m+[m[32mcluster_name=$(ciux get clustername $DIR)[m
[32m+[m[32mmonitoring=false[m
[32m+[m
[32m+[m[32m# Get kind version from option -k[m
[32m+[m[32mwhile getopts mk: flag[m
